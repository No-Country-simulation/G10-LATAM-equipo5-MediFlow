# Punto de entrada público: único servicio con puertos abiertos (80/443).
# - Sirve el front compilado.
# - /api/*     -> backend FastAPI
# - /webhook/* -> n8n (solo los webhooks; el editor de n8n NO se publica)
# Con DOMAIN=midominio.cl, Caddy obtiene y renueva el certificado HTTPS (Let's Encrypt) solo.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# frame-src/img-src: vista previa de documentos con URLs pre-firmadas de OCI Object Storage.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.oraclecloud.com; frame-src https://*.oraclecloud.com; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		request_body {
			max_size 20MB
		}
		reverse_proxy backend:8000
	}

	handle /webhook/* {
		request_body {
			max_size 12MB
		}
		reverse_proxy n8n:5678
	}

	handle {
		root * /srv
		# Los assets llevan hash en el nombre: se pueden cachear sin límite.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
