# Punto de entrada público: único servicio con puertos abiertos (80/443).
# - Sirve el front compilado.
# - /api/*     -> backend FastAPI
# - /webhook/* -> n8n (solo los webhooks; el editor de n8n NO se publica)
# SITE_ADDRESS (por defecto = DOMAIN, ver docker-compose.prod.yml):
# - midominio.cl: Caddy obtiene y renueva el certificado HTTPS (Let's Encrypt) solo (VM con IP pública, OCI).
# - :80: solo HTTP, detrás de un proxy que termina TLS (Cloudflare Tunnel en Proxmox).
{
	email {$ACME_EMAIL}
	servers {
		# Solo detrás de estos proxies se cree la IP del cliente que informan (Cf-Connecting-Ip la fija
		# Cloudflare y el cliente no la puede falsificar). Con el valor por defecto (127.0.0.1/32) se usa la
		# IP de la conexión. El backend la usa para el bloqueo de login (usuario + IP).
		trusted_proxies static {$TRUSTED_PROXIES}
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# frame-src/img-src: vista previa de documentos con URLs pre-firmadas de OCI Object Storage.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.oraclecloud.com; frame-src https://*.oraclecloud.com; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		request_body {
			max_size 20MB
		}
		reverse_proxy backend:8000 {
			# Uvicorn toma la primera IP de X-Forwarded-For: se reemplaza por la ya validada arriba, para
			# que un X-Forwarded-For inventado por el cliente no esquive el bloqueo de login.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /webhook/* {
		request_body {
			max_size 12MB
		}
		reverse_proxy n8n:5678
	}

	handle {
		root * /srv
		# Los assets llevan hash en el nombre: se pueden cachear sin límite.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
