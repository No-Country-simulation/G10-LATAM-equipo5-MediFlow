# Desarrollo local (backend con uvicorn y n8n del docker-compose.yml).
# En producción (docker-compose.prod.yml) no se usa este archivo: el front se compila con rutas
# relativas (/api/v1 y /webhook/triaje-medico) y Caddy las enruta en el mismo dominio.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/triaje-medico
