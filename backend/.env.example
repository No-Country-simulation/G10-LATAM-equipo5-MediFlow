# ==============================
# MediFlow API - Variables de entorno
# Copia este archivo como .env y completa los valores reales.
# ==============================

# Aplicación
PROJECT_NAME="MediFlow API"
ENVIRONMENT=development
# Imprime cada SQL con sus parámetros (datos de pacientes): solo para depurar
DB_ECHO=false

# Base de datos (PostgreSQL - driver asíncrono asyncpg)
# Si usas el Postgres levantado por el docker-compose.yml de la raíz del repo,
# el usuario/password/db deben coincidir con los definidos en el .env de la raíz.
DATABASE_URL=postgresql+asyncpg://mediflow_admin:mediflow_secure_pass_2026@localhost:5432/mediflow_db

# Autenticación (JWT)
# Genera un valor seguro en producción, por ejemplo con (Se debe tener instalado openssl): openssl rand -hex 32
JWT_SECRET_KEY=insecure-dev-secret-change-me
JWT_ALGORITHM=HS256
# Duración del token en minutos (los comentarios en la misma línea no son válidos en .env)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Bloqueo del login tras intentos fallidos (usuario + IP)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Oracle Cloud Infrastructure (OCI) Object Storage
# api_key: usuario + llave PEM (desarrollo). instance_principal: VM de OCI sin llaves (producción).
OCI_AUTH_MODE=api_key
OCI_USER_OCID=ocid1.user.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_TENANCY_OCID=ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_REGION=sa-saopaulo-1
OCI_KEY_FILE_PATH=./secrets/oci_api_key.pem
OCI_BUCKET_NAME=mediflow-documents
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# CORS
# Orígenes permitidos separados por coma (sin "/" final). Agrega aquí la URL del frontend desplegado.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Opcional: regex para orígenes variables (ej. previews de Vercel). Déjala vacía si no aplica.
# BACKEND_CORS_ORIGIN_REGEX=https://mediflow-.*\.vercel\.app
