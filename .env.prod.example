# ==============================
# Producción (docker-compose.prod.yml). En la VM: cp .env.prod.example .env y completar.
# Genera los secretos con: openssl rand -hex 32   (hex: sin caracteres que rompan la URL de la BD)
# ==============================

# Dominio público (registro A apuntando a la IP pública de la VM) y correo para Let's Encrypt
DOMAIN=mediflow.midominio.cl
ACME_EMAIL=equipo@midominio.cl

# PostgreSQL
POSTGRES_USER=mediflow_admin
POSTGRES_PASSWORD=
POSTGRES_DB=mediflow_db

# API
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# OCI Object Storage. Recomendado: instance_principal (sin llaves en la VM; ver docs/DESPLIEGUE_OCI.md).
OCI_AUTH_MODE=instance_principal
OCI_REGION=sa-saopaulo-1
OCI_BUCKET_NAME=mediflow-documents
OCI_COMPARTMENT_OCID=
# Solo si OCI_AUTH_MODE=api_key (además copiar la llave a backend/secrets/oci_api_key.pem)
OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_FINGERPRINT=

# n8n: fija la versión con la que se probó el workflow y genera una llave de cifrado estable
N8N_VERSION=latest
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=America/Santiago
