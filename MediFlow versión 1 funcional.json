      "id": "b4a18677-bd49-42e5-8e37-b535286cb153",
      "name": "Extract Text from PDF"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=IMPORTANTE: RESPONDE ÚNICAMENTE CON UN OBJETO JSON VÁLIDO. NO AGREGUES TEXTO EXPLICATIVO, NI INTRODUCCIONES, NI FORMATO MARKDOWN CÓDIGO (NO USES ```json).\n\nEstructura requerida:\n{\n  \"documento\": {\n    \"tipo\": \"Urgencias Médicas\" | \"Receta Médica\" | \"Orden de Solicitud de Procedimiento\" | \"Epicrisis / Informe de Alta\" | \"Certificado Médico\" | \"Desconocido\",\n    \"confianza_clasificacion\": 0.95\n  },\n  \"paciente\": {\n    \"nombre_completo\": \"\",\n    \"identificacion\": \"\",\n    \"edad\": null\n  },\n  \"profesional\": {\n    \"nombre_completo\": \"\",\n    \"especialidad\": \"\",\n    \"matricula\": \"\"\n  },\n  \"clinico\": {\n    \"hipotesis_diagnostica\": \"\",\n    \"codigo_cie10\": \"\",\n    \"urgencia\": true | false\n  },\n  \"metadata_control\": {\n    \"requiere_revision_humana\": false\n  }\n}\n\nALGORITMO DE CLASIFICACIÓN POR TÍTULOS Y TEXTO:\n1. Si el título, membrete o texto incluye \"URGENCIA\", \"SERVICIO DE URGENCIA\", \"ALTA PRIORIDAD\" o \"TRIAGE\":\n   -> documento.tipo = \"Urgencias Médicas\"\n   -> clinico.urgencia = true\n\n2. Si dice \"RECETA\", \"RECETA MÉDICA\" o \"PRESCRIPCIÓN\":\n   -> documento.tipo = \"Receta Médica\"\n   -> clinico.urgencia = false\n\n3. Si dice \"AUDITORÍA\", \"SOLICITUD DE AUTORIZACIÓN\" u \"ORDEN DE ESTUDIO\":\n   -> documento.tipo = \"Orden de Solicitud de Procedimiento\"\n   -> clinico.urgencia = false\n\n4. Si dice \"EPICRISIS\", \"INFORME DE ALTA\" o \"INFORME DE ESTUDIO\":\n   -> documento.tipo = \"Epicrisis / Informe de Alta\"\n   -> clinico.urgencia = false\n\n5. Si dice \"CERTIFICADO\" o \"LICENCIA\":\n   -> documento.tipo = \"Certificado Médico\"\n   -> clinico.urgencia = false\n\nTEXTO A ANALIZAR:\n{{ $json.text }}"
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        -384,
        -112
      ],
      "id": "fbdb649f-4458-4ee1-8f79-da4ad35e3d9f",
      "name": "Triaje e Extracción IA"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"documento\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"tipo\": {\n          \"type\": \"string\",\n          \"enum\": [\"Receta Médica\", \"Informe de Estudio de Diagnóstico\", \"Orden de Solicitud de Procedimiento\", \"Epicrisis / Informe de Alta\", \"Certificado Médico\", \"Desconocido\"]\n        },\n        \"confianza_clasificacion\": { \"type\": \"number\" }\n      },\n      \"required\": [\"tipo\", \"confianza_clasificacion\"]\n    },\n    \"paciente\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"nombre_completo\": { \"type\": \"string\" },\n        \"identificacion\": { \"type\": \"string\" },\n        \"edad\": { \"type\": \"integer\" }\n      }\n    },\n    \"profesional\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"nombre_completo\": { \"type\": \"string\" },\n        \"especialidad\": { \"type\": \"string\" },\n        \"matricula\": { \"type\": \"string\" }\n      }\n    },\n    \"clinico\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"hipotesis_diagnostica\": { \"type\": \"string\" },\n        \"codigo_cie10\": { \"type\": \"string\" },\n        \"urgencia\": { \"type\": \"boolean\" },\n        \"estudios_solicitados\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"medicamentos\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"nombre\": { \"type\": \"string\" },\n              \"dosis\": { \"type\": \"string\" },\n              \"frecuencia\": { \"type\": \"string\" }\n            }\n          }\n        }\n      },\n      \"required\": [\"urgencia\"]\n    }\n  },\n  \"required\": [\"documento\", \"paciente\", \"profesional\", \"clinico\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        -1056,
        512
      ],
      "id": "61d7a629-b214-4aef-b0c5-ea123d2cd0a9",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "// 1. Obtener la salida del nodo anterior\nconst input = $input.first().json;\nlet rawText = input.text || input.output || input;\n\nif (typeof rawText === 'object') {\n  rawText = JSON.stringify(rawText);\n}\n\nlet rawData = {};\n\ntry {\n  const jsonMatch = rawText.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    rawData = JSON.parse(jsonMatch[0]);\n  } else {\n    rawData = JSON.parse(rawText);\n  }\n} catch (e) {\n  rawData = {};\n}\n\n// 2. Extraer campos clave\nconst tipoDoc = rawData.documento?.tipo || rawData.tipo_documento || \"Desconocido\";\n\n// EVALUACIÓN ESTRICTA: Solo es urgente si el TIPO de documento es explícitamente \"Urgencias Médicas\"\n// o si la IA marcó clinico.urgencia como true de forma explícita.\nconst esUrgente = Boolean(\n  tipoDoc === \"Urgencias Médicas\" || \n  (rawData.clinico?.urgencia === true && tipoDoc !== \"Receta Médica\")\n);\n\nconst scoreConfianza = rawData.documento?.confianza_clasificacion ?? 0.95;\n\n// 3. Evaluar reglas de ambigüedad y revisión humana\nlet requiereRevision = false;\nlet motivos = [];\n\nif (esUrgente) {\n  requiereRevision = false;\n} else {\n  if (rawData.metadata_control?.requiere_revision_humana === true) {\n    requiereRevision = true;\n    motivos.push(\"Datos incompletos identificados por la IA\");\n  }\n  if (scoreConfianza < 0.60) {\n    requiereRevision = true;\n    motivos.push(\"Confianza de clasificación baja (<60%)\");\n  }\n  if (tipoDoc === \"Desconocido\") {\n    requiereRevision = true;\n    motivos.push(\"Tipo de documento no identificado por título\");\n  }\n}\n\n// 4. Salida limpia\nreturn {\n  documento: {\n    tipo: tipoDoc,\n    confianza_clasificacion: scoreConfianza\n  },\n  paciente: rawData.paciente || {},\n  profesional: rawData.profesional || {},\n  clinico: {\n    urgencia: esUrgente,\n    hipotesis_diagnostica: rawData.clinico?.hipotesis_diagnostica || \"\"\n  },\n  metadata_control: {\n    requiere_revision_humana: requiereRevision,\n    motivos_revision: motivos,\n    fecha_procesamiento: new Date().toISOString()\n  }\n};"
      },
