# ==============================
# Variables de infraestructura para docker-compose.yml (raíz del monorepo)
# Copia este archivo como .env y ajusta los valores si lo necesitas.
#
# IMPORTANTE: este .env es SOLO para las credenciales del contenedor de Postgres
# que levanta docker-compose. Los secretos propios de cada servicio (backend,
# frontend, workflow) viven en su propio .env dentro de su carpeta
# (ej. backend/.env), no aquí.
# ==============================

POSTGRES_USER=mediflow_admin
POSTGRES_PASSWORD=mediflow_secure_pass_2026
POSTGRES_DB=mediflow_db
