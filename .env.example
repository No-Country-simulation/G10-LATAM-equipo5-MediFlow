# ============================================
# MediFlow - Variables de entorno de ejemplo
# Copiar este archivo como ".env" y completar
# los valores reales antes de levantar los
# servicios. Nunca commitear el archivo ".env".
# ============================================

# --- Entorno general ---
# development | staging | production
ENVIRONMENT=development

# --- Backend (FastAPI) ---
# Puerto en el que se expone la API dentro del contenedor/host
BACKEND_PORT=8000

# --- Orquestación (n8n) ---
# URL del webhook de n8n que recibe el resultado del triaje clínico
N8N_WEBHOOK_URL=http://n8n:5678/webhook/triage

# --- Oracle Cloud Infrastructure (OCI) ---
# OCID del usuario autenticado en OCI
OCI_USER_OCID=ocid1.user.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OCID del tenancy (arrendamiento) de OCI
OCI_TENANCY_OCID=ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Huella (fingerprint) de la clave API generada en OCI
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
# Región de OCI donde vive el bucket
OCI_REGION=us-ashburn-1
# Ruta al archivo .pem de la clave privada de la API de OCI (montado como secreto)
OCI_KEY_FILE_PATH=/secrets/oci_api_key.pem
# Nombre del bucket de Object Storage donde se almacenan los documentos clínicos
OCI_BUCKET_NAME=mediflow-documentos-clinicos

# --- Proveedores de LLM ---
# Clave de API de Groq (modelos de inferencia rápida)
GROQ_API_KEY=your_groq_api_key_here
# Clave de API de Google Gemini (modelos multimodales)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Frontend (Vite) ---
# URL base que el frontend usa para consumir la API del backend
VITE_API_BASE_URL=http://localhost:8000/api/v1
